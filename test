const heart = document.getElementById("heart");
const world = document.getElementById("world");
const game = document.getElementById("game");
const dialog = document.getElementById("dialog");
const light = document.getElementById("light");

const objects = document.querySelectorAll(".object");

let x = 0, y = 0;
const speed = 2;

let keys = {up:false,down:false,left:false,right:false};

/* INIT (per room) */
function initGame(config) {
    x = config.spawn.x;
    y = config.spawn.y;

    world.style.width = config.worldSize.width + "px";
    world.style.height = config.worldSize.height + "px";
}

/* COLLISION */
function isColliding(nx, ny) {
    for (let obj of objects) {
        if (obj.dataset.collidable === "false") continue;

        const r = obj.getBoundingClientRect();
        const wr = world.getBoundingClientRect();

        const ox = r.left - wr.left;
        const oy = r.top - wr.top;

        if (
            nx < ox + obj.offsetWidth &&
            nx + 20 > ox &&
            ny < oy + obj.offsetHeight &&
            ny + 20 > oy
        ) return true;
    }
    return false;
}

/* LOOP */
function update() {
    let nx = x;
    let ny = y;

    if (keys.up) ny -= speed;
    if (keys.down) ny += speed;
    if (keys.left) nx -= speed;
    if (keys.right) nx += speed;

    if (!isColliding(nx, y)) x = nx;
    if (!isColliding(x, ny)) y = ny;

    x = Math.max(0, Math.min(world.clientWidth - 30, x));
    y = Math.max(0, Math.min(world.clientHeight - 30, y));

    heart.style.left = x + "px";
    heart.style.top = y + "px";

    light.style.left = (x - 100) + "px";
    light.style.top = (y - 100) + "px";

    updateCamera();
    requestAnimationFrame(update);
}
update();

/* CAMERA */
function updateCamera() {
    let camX = x - game.clientWidth / 2;
    let camY = y - game.clientHeight / 2;

    camX = Math.max(0, Math.min(world.clientWidth - game.clientWidth, camX));
    camY = Math.max(0, Math.min(world.clientHeight - game.clientHeight, camY));

    world.style.transform = `translate(${-camX}px, ${-camY}px)`;
}

/* INTERACT (same logic reused) */
function interact() {
    for (let obj of objects) {
        const ox = obj.offsetLeft;
        const oy = obj.offsetTop;
        const d = Math.hypot(x - ox, y - oy);

        if (d < (parseInt(obj.dataset.radius) || 60)) {

            if (obj.dataset.goto) {
                window.location.href = obj.dataset.goto;
                return;
            }

            dialog.innerText = obj.dataset.text || "Nothing here.";
            dialog.style.display = "block";

            setTimeout(() => dialog.style.display = "none", 1000);
            return;
        }
    }
}

/* INPUT */
document.addEventListener("keydown", e=>{
    if(e.key==="ArrowUp") keys.up=true;
    if(e.key==="ArrowDown") keys.down=true;
    if(e.key==="ArrowLeft") keys.left=true;
    if(e.key==="ArrowRight") keys.right=true;
    if(e.key==="e") interact();
});
document.addEventListener("keyup", e=>{
    if(e.key==="ArrowUp") keys.up=false;
    if(e.key==="ArrowDown") keys.down=false;
    if(e.key==="ArrowLeft") keys.left=false;
    if(e.key==="ArrowRight") keys.right=false;
});

/* MOBILE CONTROLS */
function bind(sel,key){
    const b=document.querySelector(sel);
    b.addEventListener("touchstart",e=>{e.preventDefault();keys[key]=true});
    b.addEventListener("touchend",()=>keys[key]=false);
    b.addEventListener("mousedown",()=>keys[key]=true);
    b.addEventListener("mouseup",()=>keys[key]=false);
}
bind(".up","up"); bind(".down","down"); bind(".left","left"); bind(".right","right");

document.querySelector(".interact").onclick = interact;